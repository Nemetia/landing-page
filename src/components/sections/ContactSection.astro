---
import type { Translations } from "../../i18n/types"

interface Props {
  translations: Translations
}

const { translations } = Astro.props
---

<section id="contact" class="contact">
  <div class="container">
    <div class="section-heading contact-heading">
      <p class="t-eyebrow contact-eyebrow">{translations.nav.contact}</p>
      <h2 class="section-title" set:html={translations.contact.sectionTitle}></h2>
      <p class="section-desc contact-desc">
        {translations.contact.sectionDescription}
      </p>
    </div>

    <form class="contact-card">
      <div class="contact-form-grid">
        <div class="field">
          <label for="name">{translations.contact.nameLabel}</label>
          <input
            id="name"
            name="name"
            type="text"
            placeholder={translations.contact.namePlaceholder}
          />
        </div>
        <div class="field">
          <label for="email">{translations.contact.emailLabel}</label>
          <input
            id="email"
            name="email"
            type="email"
            placeholder={translations.contact.emailPlaceholder}
          />
        </div>
      </div>

      <div class="field">
        <label for="message">{translations.contact.messageLabel}</label>
        <textarea
          id="message"
          name="message"
          placeholder={translations.contact.messagePlaceholder}
        ></textarea>
      </div>

      <div class="contact-submit">
        <button type="button" class="btn btn-primary">
          {translations.contact.submitText}
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M3 8 L13 8 M9 4 L13 8 L9 12" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </div>
    </form>
  </div>
</section>
