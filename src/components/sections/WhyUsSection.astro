---
import type { Translations } from "../../i18n/types"

interface Props {
  translations: Translations
}

const { translations } = Astro.props

const whyUsHighlights = [
  {
    mark: "i",
    title: translations.whyUs.tailoredSolutions.title,
    description: translations.whyUs.tailoredSolutions.description,
  },
  {
    mark: "ii",
    title: translations.whyUs.sustainableGrowth.title,
    description: translations.whyUs.sustainableGrowth.description,
  },
  {
    mark: "iii",
    title: translations.whyUs.closeSupport.title,
    description: translations.whyUs.closeSupport.description,
  },
]
---

<section id="why-us" class="why-us-section">
  <div class="container">
    <div class="why-us-layout">
      <div>
        <p class="t-eyebrow">{translations.nav.whyUs}</p>
        <h2 class="section-title" set:html={translations.whyUs.sectionTitle}></h2>
        <p class="section-desc">
          {translations.whyUs.sectionDescription}
        </p>

        <div class="why-us-highlights">
          {
            whyUsHighlights.map((highlight) => (
              <div class="why-us-highlight">
                <div class="why-us-highlight-mark">{highlight.mark}</div>
                <div>
                  <h3 class="why-us-highlight-title">{highlight.title}</h3>
                  <p class="why-us-highlight-desc">{highlight.description}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <div class="rings-wrap">
        <svg viewBox="0 0 480 480" fill="none" aria-hidden="true">
          <circle cx="240" cy="240" r="220" stroke="#11d432" stroke-opacity="0.08" stroke-width="1.5" />
          <circle cx="240" cy="240" r="200" stroke="#11d432" stroke-opacity="0.14" stroke-width="1.5" />
          <circle cx="240" cy="240" r="178" stroke="#11d432" stroke-opacity="0.2" stroke-width="1.5" />
          <circle cx="240" cy="240" r="155" stroke="#11d432" stroke-opacity="0.28" stroke-width="1.5" />
          <circle cx="240" cy="240" r="132" stroke="#11d432" stroke-opacity="0.36" stroke-width="1.5" />
          <circle cx="240" cy="240" r="108" stroke="#11d432" stroke-opacity="0.46" stroke-width="2" />
          <circle cx="240" cy="240" r="84" stroke="#11d432" stroke-opacity="0.58" stroke-width="2" />
          <circle cx="240" cy="240" r="60" stroke="#11d432" stroke-opacity="0.72" stroke-width="2.5" />
          <circle cx="240" cy="240" r="38" stroke="#11d432" stroke-opacity="0.88" stroke-width="2.5" />
          <circle cx="240" cy="240" r="20" fill="#11d432" />
          <path d="M240 20 L240 218" stroke="#11d432" stroke-opacity="0.06" />
          <path d="M240 262 L240 460" stroke="#11d432" stroke-opacity="0.06" />
          <path d="M20 240 L218 240" stroke="#11d432" stroke-opacity="0.06" />
          <path d="M262 240 L460 240" stroke="#11d432" stroke-opacity="0.06" />
        </svg>
        <div class="rings-center">
          <div class="rings-num">{translations.whyUs.statsValue}</div>
          <div class="rings-lbl">{translations.whyUs.statsLabel}</div>
        </div>
      </div>
    </div>
  </div>
</section>
