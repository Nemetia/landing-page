---
import type { Translations } from "../../i18n/types"

interface Props {
  translations: Translations
}

const { translations } = Astro.props
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="brand footer-brand">
      <img
        src={`${import.meta.env.BASE_URL}images/nemetia-footer-logo.png`}
        alt=""
      />
      <span class="brand-name footer-brand-name">Nemetia</span>
    </div>

    <ul class="footer-links">
      <li><a href="#">{translations.footer.privacyPolicy}</a></li>
      <li><a href="#">{translations.footer.termsAndConditions}</a></li>
      <li><a href="#">{translations.footer.socialLink}</a></li>
    </ul>

    <div class="footer-copy">{translations.footer.copyright}</div>
  </div>
</footer>
